/target

# Release build artifacts (the packaging templates under dist/ are tracked;
# everything generated by the release workflow is not).
/dist/staging/
/dist/rpmbuild/
/dist/*.tar.gz
/dist/*.sha256
/dist/*.deb
/dist/*.rpm
/dist/debian/*/usr/
/dist/rpm/*/usr/

# npm package: downloaded binary + local install artifacts
/npm/vendor/
/npm/node_modules/
/npm/*.tgz

# Separate application checkout used by manually dispatched Dagger workflows.
/.source/

# FluentCI generated SDKs, compiler outputs, and workflow tooling checkout
/.ci-tooling/
.fluentci/**/.sdk/
.fluentci/**/.spago/
.fluentci/**/output/
.fluentci/**/dist/
.fluentci/**/node_modules/

# FluentCI generated dependency bindings
.fluentci/**/.fluentci/
.fluentci/**/fluentci_modules/
